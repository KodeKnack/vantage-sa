generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  role            Role       @default(GRADUATE)
  name            String
  email           String     @unique
  passwordHash    String
  aptitudeScore   Int?
  verifiedSkills  Skill[]
  microTasks      MicroTask[]
  taxIncentiveRef String?
  createdAt       DateTime   @default(now())
}

model Skill {
  id         String  @id @default(cuid())
  name       String
  isVerified Boolean @default(false)
  proofHash  String?
  proofLink  String?
  userId     String
  user       User    @relation(fields: [userId], references: [id])
}

model MicroTask {
  id         String   @id @default(cuid())
  title      String
  type       TaskType
  prompt     String
  userId     String
  submission String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model BbeeLog {
  id           String   @id @default(cuid())
  employerId   String
  graduateId   String
  hireDate     DateTime
  taxRebateZAR Int
  bbeePoints   Float
  createdAt    DateTime @default(now())
}

enum Role {
  GRADUATE
  EMPLOYER
  ADMIN
}

enum TaskType {
  SQL
  WRITING
  LOGIC
  DATA
}

